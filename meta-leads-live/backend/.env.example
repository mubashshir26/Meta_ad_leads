# Copy to .env and fill in.
PORT=3000

# Any string you choose; paste the same value into Meta's webhook "Verify token" field.
VERIFY_TOKEN=myleadtoken123

# Meta App Dashboard -> App settings -> Basic -> App secret (used to verify X-Hub-Signature-256).
APP_SECRET=d9b40ad6a8b9c4687d1512e7631f9f21

# Page access token with leads_retrieval (+ pages_show_list, pages_manage_metadata, pages_read_engagement).
PAGE_ACCESS_TOKEN=

GRAPH_VERSION=v23.0

# Local testing only. Leave false when using the real Lead Testing Tool.
DEV_MOCK_GRAPH=false
ENABLE_DEV_ROUTES=false
